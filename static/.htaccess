# ==========================================================================
# ZeroX sayt — Apache .htaccess (Nuxt 2, target: static, ssr: false)
# 2026-09-25 (SS-PERF/SS-SEC): siqish, kesh, xavfsizlik sarlavhalari, SPA fallback.
#
# ⚠️ Bu fayl `static/` ichida turadi — `nuxt generate` uni har safar `dist/` ga
#    nusxalaydi. Serverga QO'LDA qo'shmang, aks holda keyingi deployda yo'qoladi.
# ⚠️ `.htaccess` ichida <Location>/<LocationMatch> ISHLAMAYDI (500 beradi) —
#    faqat <FilesMatch>/<Files>/Rewrite/Header ishlating.
# ⚠️ Statik `_nuxt/*.js|css|png…` fayllarni nginx o'zi beradi (expires max) —
#    Apache faqat HTML va fallback uchun ishlaydi.
# ==========================================================================

Options -Indexes
AddDefaultCharset utf-8

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType application/javascript .mjs
</IfModule>

# --- Siqish (nginx gzip ham bor; Apache orqali o'tgan HTML/JSON uchun) ---
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/xml text/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/xml text/xml
  <IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|woff2?)$ no-gzip dont-vary
  </IfModule>
  <IfModule mod_headers.c>
    Header append Vary Accept-Encoding env=!dont-vary
  </IfModule>
</IfModule>

# --- Kesh ---
<IfModule mod_headers.c>
  # Ilova qobig'i hech qachon keshlanmasin — aks holda yangi deploydan keyin ham
  # brauzer eski chunk nomlarini so'rab 404 oladi.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Hash'li build fayllari (nginx o'tkazib yuborgan holatlar uchun)
  <FilesMatch "\.[0-9a-f]{8}\.(?:js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^(?:manifest|sw)\.(?:json|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Xavfsizlik sarlavhalari ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # Telegram Mini App iframe ichida ochiladi — X-Frame-Options o'rniga frame-ancestors.
  Header always unset X-Frame-Options
  Header always set Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org https://*.t.me"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()"
  Header always set X-XSS-Protection "0"
</IfModule>

# --- SPA fallback ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Yashirin fayllar (.env, .git, .htaccess) — taqiq (.well-known bundan mustasno)
  RewriteRule ^\.(?!well-known/) - [F,L]

  # 1) Haqiqiy fayl yoki papka bo'lsa — tegmaymiz
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2) Build aktivlari va xizmat fayllari: yo'q bo'lsa HAQIQIY 404 (HTML qaytmasin —
  #    aks holda konsolda "Unexpected token <" chiqadi)
  RewriteRule ^_nuxt/ - [R=404,L]
  RewriteRule ^(sw\.js|robots\.txt|sitemap\.xml|favicon\.ico)$ - [R=404,L]

  # 3) Qolgan hammasi — SPA fallback (holat 200), marshrutni vue-router hal qiladi
  RewriteRule ^ /200.html [L]
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
